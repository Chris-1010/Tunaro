<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".activites.AlbumView">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="@android:color/black"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="false"
            app:toolbarId="@+id/collapsed_toolbar">

            <!-- Expanded header: parallax-scrolls away as the bar collapses. Top padding clears
                 the pinned toolbar so the cover doesn't sit under the back arrow. -->
            <LinearLayout
                android:id="@+id/header_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="?attr/actionBarSize"
                android:paddingBottom="16dp"
                app:layout_collapseMode="parallax">

                <androidx.cardview.widget.CardView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    app:cardBackgroundColor="@color/blueBlack"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="8dp">

                    <ImageView
                        android:id="@+id/album_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/album_cover"
                        android:scaleType="centerCrop"
                        android:src="@drawable/song_placeholder"
                        tools:srcCompat="@tools:sample/backgrounds/scenic" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/album_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="Album Name" />

                <!-- Shown on a first-ever visit while the album's details load. -->
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/header_meta_shimmer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:layout_width="140dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="12dp"
                            android:background="@color/shimmer_placeholder" />

                        <View
                            android:layout_width="200dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="12dp"
                            android:background="@color/shimmer_placeholder" />

                        <View
                            android:layout_width="120dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:background="@color/shimmer_placeholder" />
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <LinearLayout
                    android:id="@+id/header_meta_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- Artist names; each is a tappable span that opens ArtistView. -->
                    <TextView
                        android:id="@+id/album_artists"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:minHeight="32dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/tanAccent"
                        android:textColorLink="@color/tanAccent"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Artist One, Artist Two"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/album_type_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/album_type_chip"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="2dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="Album"
                            tools:textColor="#FF2196F3"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/album_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#B3FFFFFF"
                            android:textSize="14sp"
                            tools:text="2019 · 12 songs · 43 min" />
                    </LinearLayout>

                    <!-- Record label, once known from Spotify. -->
                    <TextView
                        android:id="@+id/album_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Some Label Records"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/album_play_button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:enabled="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="128dp"
                        android:text="@string/album_play"
                        android:textAllCaps="false"
                        android:textColor="@color/blueBlack"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/tanAccent"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_notif_play"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/blueBlack" />
                </LinearLayout>
            </LinearLayout>

            <!-- Collapsed toolbar: back arrow plus a small cover and name that fade in once the
                 header has collapsed. -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/collapsed_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:gravity="center_vertical"
                app:contentInsetStartWithNavigation="0dp"
                app:layout_collapseMode="pin"
                app:navigationContentDescription="@string/back"
                app:navigationIcon="@drawable/ic_arrow_back">

                <androidx.cardview.widget.CardView
                    android:id="@+id/collapsed_cover_card"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    tools:alpha="1">

                    <ImageView
                        android:id="@+id/collapsed_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/empty"
                        android:scaleType="centerCrop"
                        android:src="@drawable/song_placeholder" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/collapsed_album_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:alpha="1"
                    tools:text="Album Name" />
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Track list area: list, first-load shimmer and error state share the space below the
         app bar. -->
    <FrameLayout
        android:id="@+id/tracks_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/album_tracks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="96dp"
            tools:listitem="@layout/song_recycler_view_row" />

        <include
            android:id="@+id/tracks_shimmer"
            layout="@layout/view_list_shimmer" />

        <!-- Error state: shown only when nothing could be loaded (no local data, request failed). -->
        <include
            android:id="@+id/tracks_error"
            layout="@layout/view_state_message" />
    </FrameLayout>

    <include
        android:id="@+id/playback_bar"
        layout="@layout/playback_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/playback_bar_height"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
