<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header with Back Button, Album Cover, Song Info -->
            <LinearLayout
                android:id="@+id/header_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Back Button -->
                <LinearLayout
                    android:id="@+id/back_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/ripple_rounded_background"
                    android:backgroundTint="@color/transparent_black"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@string/empty"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/back_button_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Back"
                        android:textColor="@android:color/white"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- Album Cover + Playlist Panel container -->
                <!-- FrameLayout: panel sits behind the cover, slides left on tap -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="10dp">

                    <!-- Playlist Panel (behind the album cover, slides out to the left) -->
                    <LinearLayout
                        android:id="@+id/playlist_panel"
                        android:layout_width="56dp"
                        android:layout_height="280dp"
                        android:layout_gravity="start|top"
                        android:background="@drawable/rounded_md"
                        android:backgroundTint="#CC000000"
                        android:clipToPadding="false"
                        android:gravity="center|left"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:translationX="-56dp"
                        android:visibility="invisible"
                        tools:translationX="0dp"
                        tools:visibility="visible">

                        <!-- Playlist icons populated dynamically -->
                        <!-- "Not in any playlists" label shown when empty -->
                        <TextView
                            android:id="@+id/playlist_panel_empty"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Not in any playlists"
                            android:textColor="#99FFFFFF"
                            android:textSize="10sp"
                            android:visibility="gone" />

                        <androidx.core.widget.NestedScrollView
                            android:id="@+id/playlist_panel_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:overScrollMode="never"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <LinearLayout
                                android:id="@+id/playlist_panel_icons"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="4dp" />

                        </androidx.core.widget.NestedScrollView>

                        <!-- Manage: opens the add-to-playlist sheet. Always visible so the
                             song can be added even when it's in no playlists yet. -->
                        <ImageView
                            android:id="@+id/playlist_panel_manage"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/ripple_rounded_background"
                            android:backgroundTint="#33FFFFFF"
                            android:clickable="true"
                            android:contentDescription="@string/add_to_playlist_title"
                            android:focusable="true"
                            android:padding="8dp"
                            android:src="@drawable/ic_add"
                            app:tint="@color/white" />

                    </LinearLayout>

                    <!-- Album Cover (tap → toggle panel, long-press → play) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:layout_gravity="center|top"
                        android:foreground="@drawable/image_border"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="8dp">

                        <ImageView
                            android:id="@+id/SongView_AlbumCover"
                            android:layout_width="280dp"
                            android:layout_height="280dp"
                            android:contentDescription="@string/songAlbumCoverImage"
                            android:cropToPadding="true"
                            android:longClickable="true"
                            android:scaleType="centerCrop"
                            tools:srcCompat="@tools:sample/backgrounds/scenic" />

                        <!-- "NEW" pill — shown for songs Tunaro hasn't seen before -->
                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/new_song_pill_shimmer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="10dp"
                            android:visibility="gone"
                            app:shimmer_base_alpha="1"
                            app:shimmer_highlight_alpha="0.65"
                            app:shimmer_duration="5000"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/new_song_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/pill_new_song"
                                android:elevation="4dp"
                                android:letterSpacing="0.12"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="6dp"
                                android:text="NEW"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </com.facebook.shimmer.ShimmerFrameLayout>
                    </androidx.cardview.widget.CardView>

                </FrameLayout>

                <!-- Song Name and Artist -->
                <TextView
                    android:id="@+id/SongView_SongName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:paddingHorizontal="16dp"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="@string/app_name"
                    android:textAlignment="center"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Retained for the header shimmer/fade choreography; the visible artist names
                     are rendered as tappable chips in SongView_ArtistChips below. -->
                <TextView
                    android:id="@+id/SongView_ArtistName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:text="Artist 1, Artist 2" />

                <!-- One tappable chip per artist; each opens ArtistView for that artist. -->
                <LinearLayout
                    android:id="@+id/SongView_ArtistChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp" />

            </LinearLayout>

            <!-- Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:contentDescription="@string/songViewTabsDesc"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:tabGravity="center"
                app:tabMode="fixed"
                app:tabIndicatorHeight="0dp"
                app:tabPaddingEnd="2dp"
                app:tabPaddingStart="2dp" />

            <!-- ViewPager for tab content -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:overScrollMode="never" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/playback_bar"
        layout="@layout/playback_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/playback_bar_height"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
