<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darker_grey">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@drawable/radial_gradient"
            app:expandedTitleMarginBottom="16dp"
            app:expandedTitleMarginStart="16dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="true">

            <!-- Expanded header content -->
            <LinearLayout
                android:id="@+id/expanded_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_lg"
                app:layout_collapseMode="parallax">

                <androidx.cardview.widget.CardView
                    android:id="@+id/detailed_playlistCover_card"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:foreground="@drawable/image_border"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp">

                    <ImageView
                        android:id="@+id/detailed_playlistCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/playlistCoverImage"
                        android:scaleType="centerCrop"
                        tools:srcCompat="@tools:sample/backgrounds/scenic" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/detailed_playlistName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1px"
                    android:elevation="9dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:textAlignment="center"
                    android:textColor="@color/text_primary"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="Playlist Name" />

                <TextView
                    android:id="@+id/detailed_songCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    tools:text="470 Tracks" />
            </LinearLayout>

            <!-- Collapsed toolbar with back button and small playlist info -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_back">

                <!-- Small playlist image for collapsed state -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/collapsed_playlist_image_card"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:alpha="0"
                    android:foreground="@drawable/image_border_small"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/collapsed_playlist_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/playlistCoverImage"
                        android:scaleType="centerCrop"
                        tools:srcCompat="@tools:sample/backgrounds/scenic" />
                </androidx.cardview.widget.CardView>

            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Search and Sort Controls -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="@dimen/space_sm"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Sort row: sort widgets on the left, a search toggle on the right. Tapping the search
             icon swaps the sort widgets for an inline search field (see search_bar below). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/sort_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Sort By"
                android:padding="12dp"
                android:src="@drawable/ic_sort"
                android:visibility="visible" />

            <Spinner
                android:id="@+id/sort_spinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:paddingHorizontal="@dimen/space_xs"
                android:paddingVertical="@dimen/space_sm"
                android:theme="@style/WhiteSpinnerTheme"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/sort_direction_icon"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:contentDescription="Sort Direction"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_arrow_downward"
                android:visibility="visible" />

            <!-- Inline search field, shown only in search mode (replaces the sort widgets). -->
            <EditText
                android:id="@+id/search_bar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                style="@style/Widget.Tunaro.Input"
                android:hint="Search songs..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:padding="@dimen/space_sm"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:contentDescription="Search Icon"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_search"
                android:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Shimmer loading effect -->
    <include
        android:id="@+id/shimmer_view_container"
        layout="@layout/view_list_shimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="400dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- RecyclerView for songs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/song_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="72dp"
        android:paddingBottom="150dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/song_recycler_view_row" />

    <!-- No-matches and load-error state. Offset below the controls bar so it sits in the list
         area rather than behind the header. -->
    <include
        android:id="@+id/empty_label"
        layout="@layout/view_state_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <include
        android:id="@+id/playback_bar"
        layout="@layout/playback_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/playback_bar_height"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
