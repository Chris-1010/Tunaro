<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Shimmer placeholder shown while metadata is being fetched from API -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/details_shimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="200dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/shimmer_placeholder"
                    app:shapeAppearanceOverlay="@style/roundedImageView" />

                <View
                    android:layout_width="130dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/shimmer_placeholder"
                    app:shapeAppearanceOverlay="@style/roundedImageView" />

                <View
                    android:layout_width="100dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/shimmer_placeholder"
                    app:shapeAppearanceOverlay="@style/roundedImageView" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/shimmer_placeholder"
                    app:shapeAppearanceOverlay="@style/roundedImageView" />

            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Song Details -->
        <LinearLayout
            android:id="@+id/details_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <!-- Album Row -->
            <LinearLayout
                android:id="@+id/album_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:text="From"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/SongView_AlbumType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:overScrollMode="never"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Single" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/rounded_md"
                    android:backgroundTint="@color/dark_blue"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/SongView_AlbumName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="150dp"
                        android:textAlignment="center"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Album Name" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/empty"
                        android:src="@drawable/ic_external_link"
                        app:tint="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <!-- Artists Row — each artist (incl. features) opens ArtistView -->
            <LinearLayout
                android:id="@+id/artists_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="By"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/artist_chips_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Release Date Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Released"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/SongView_ReleaseDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    tools:text="24 Oct 2024" />
            </LinearLayout>

            <!-- Duration Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Duration"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/SongView_SongDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    tools:text="3m 25s" />
            </LinearLayout>

            <!-- Popularity Row -->
            <LinearLayout
                android:id="@+id/popularity_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Popularity"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/SongView_SongPopularity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    tools:text="75%" />
            </LinearLayout>

            <!-- Variants Row -->
            <LinearLayout
                android:id="@+id/variants_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Variants"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/variants_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    tools:text="2 encountered" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/empty"
                    android:src="@drawable/ic_arrow_downward"
                    app:tint="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Collapsible Listening History -->
        <LinearLayout
            android:id="@+id/listening_history_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Listening History Header (Collapsible) -->
            <LinearLayout
                android:id="@+id/listening_history_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Listening History"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/listen_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    tools:text="5 listens" />

                <ImageView
                    android:id="@+id/expand_collapse_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/empty"
                    android:src="@drawable/ic_arrow_downward"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <!-- Listening History Content (Expandable) -->
            <LinearLayout
                android:id="@+id/listening_history_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- This will be populated dynamically with listen entries -->
            </LinearLayout>
        </LinearLayout>

        <!-- More Details Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/more_details_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingVertical="16dp"
            android:text="More Details"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/purple_700"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button" />

        <TextView
            android:id="@+id/first_seen_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:alpha="0.45"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            tools:text="First seen 2 Jan 2025" />

        <TextView
            android:id="@+id/song_id_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.35"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            tools:text="song composite id" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
