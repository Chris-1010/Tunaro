<?xml version="1.0" encoding="utf-8"?>
<!-- Floating Confirm button for the ranking playlist sheet. Added to the dialog
     window decor (not the sheet content) so it stays pinned to the screen and is
     visible without dragging the sheet to full height. -->
<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ranking_confirm_button"
    android:layout_width="wrap_content"
    android:layout_height="64dp"
    android:backgroundTint="@color/tanAccent"
    android:text="Confirm"
    android:textColor="@color/black"
    android:textSize="20sp"
    android:textStyle="bold"
    android:visibility="gone"
    app:cornerRadius="14dp" />
