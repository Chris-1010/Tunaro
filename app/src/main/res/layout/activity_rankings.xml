<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_blue"
    tools:context=".activites.RankingsActivity">

    <TextView
        android:id="@+id/rankings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Rankings"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Setup phase: resume an in-progress game, start a new one, or view past results -->
    <LinearLayout
        android:id="@+id/setup_phase"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/playback_bar"
        app:layout_constraintTop_toBottomOf="@+id/rankings_title">

        <!-- Resume card: shown only when a game is in progress -->
        <androidx.cardview.widget.CardView
            android:id="@+id/resume_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#26FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Game in progress"
                    android:textColor="@color/tanAccent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resume_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/resume_covers_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/resume_covers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/resume_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/faintTanAccent"
                        android:textSize="13sp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resume_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/tanAccent"
                    android:text="Resume"
                    android:textColor="@color/black"
                    app:cornerRadius="22dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- New-game controls -->
        <LinearLayout
            android:id="@+id/new_game_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pool_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/tanAccent"
                android:padding="12dp"
                android:text="New Game"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:cornerRadius="24dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/past_results_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Past results"
            android:textColor="@color/faintTanAccent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_ranking_history" />

    </LinearLayout>

    <!-- Match phase: tap a card to preview, tap Choose to pick -->
    <LinearLayout
        android:id="@+id/match_phase"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/playback_bar"
        app:layout_constraintTop_toBottomOf="@+id/rankings_title"
        app:layout_constraintVertical_bias="0.15">

        <TextView
            android:id="@+id/round_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tanAccent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/match_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- Standings graph: a reshuffling ladder of the whole field, or swipeable
             round columns of pairings. Takes the space above the cards. -->
        <com.ca.tunaro.utils.SwissGraphView
            android:id="@+id/graph_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:orientation="horizontal">

            <!-- Side A -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- The border view wraps the card and paints its rotating "playing"
                     ring in its 5dp padding gutter, just outside the art. -->
                <com.ca.tunaro.utils.RotatingGradientBorderView
                    android:id="@+id/border_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    app:borderCornerRadius="12dp"
                    app:borderStrokeWidth="5dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/song_card_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#E0E0E0"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:id="@+id/badges_a"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/cover_a"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/song_name_a"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:lines="2"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/artist_name_a"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/choose_button_a"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="@color/tanAccent"
                            android:text="Choose"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            app:cornerRadius="18dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                </com.ca.tunaro.utils.RotatingGradientBorderView>

                <com.ca.tunaro.utils.MaxHeightRecyclerView
                    android:id="@+id/snippets_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:maxHeight="96dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/vs_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="60dp"
                android:text="VS"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Side B -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.ca.tunaro.utils.RotatingGradientBorderView
                    android:id="@+id/border_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    app:borderCornerRadius="12dp"
                    app:borderStrokeWidth="5dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/song_card_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#E0E0E0"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:id="@+id/badges_b"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/cover_b"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/song_name_b"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:lines="2"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/artist_name_b"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/choose_button_b"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="@color/tanAccent"
                            android:text="Choose"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            app:cornerRadius="18dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                </com.ca.tunaro.utils.RotatingGradientBorderView>

                <com.ca.tunaro.utils.MaxHeightRecyclerView
                    android:id="@+id/snippets_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:maxHeight="96dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/undo_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:enabled="false"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/tanAccent"
                android:text="Undo"
                android:textColor="@color/tanAccent"
                app:cornerRadius="22dp"
                app:strokeColor="@color/tanAccent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_exit_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save &amp; exit"
                android:textColor="@color/tanAccent"
                app:cornerRadius="22dp"
                app:strokeColor="@color/tanAccent" />

        </LinearLayout>

    </LinearLayout>

    <!-- Results phase: final standings -->
    <LinearLayout
        android:id="@+id/results_phase"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/playback_bar"
        app:layout_constraintTop_toBottomOf="@+id/rankings_title">

        <!-- Playlists this game drew from; long-press an icon for its name. Shown
             only when viewing a past result. -->
        <LinearLayout
            android:id="@+id/results_playlist_icons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/leaderboard_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Final standings"
            android:textColor="@color/tanAccent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/leaderboard_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_leaderboard_entry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/restart_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/tanAccent"
            android:padding="12dp"
            android:text="Play Again"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:cornerRadius="24dp" />

    </LinearLayout>

    <!-- Green glow from a screen edge while that side's song previews. -->
    <View
        android:id="@+id/edge_glow_left"
        android:layout_width="90dp"
        android:layout_height="0dp"
        android:background="@drawable/edge_glow_left"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/playback_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/edge_glow_right"
        android:layout_width="90dp"
        android:layout_height="0dp"
        android:background="@drawable/edge_glow_right"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/playback_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/playback_bar"
        layout="@layout/playback_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/playback_bar_height"
        android:layout_gravity="bottom"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
