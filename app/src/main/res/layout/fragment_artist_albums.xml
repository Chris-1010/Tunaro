<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- Sort controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_sm"
        android:paddingVertical="@dimen/space_xs">

        <ImageView
            android:id="@+id/sort_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/empty"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_filter"
            app:tint="@color/white" />

        <Spinner
            android:id="@+id/sort_spinner"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:theme="@style/WhiteSpinnerTheme" />

        <ImageView
            android:id="@+id/sort_direction_icon"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:contentDescription="@string/empty"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_arrow_downward"
            app:tint="@color/white" />

        <!-- Inline search field, shown only in search mode (replaces the sort widgets). -->
        <EditText
            android:id="@+id/search_bar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            style="@style/Widget.Tunaro.Input"
            android:hint="Search releases..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:padding="@dimen/space_sm"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/search_icon"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:contentDescription="@string/empty"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_search"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Shimmer while the discography is being fetched -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/albums_shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_sm">

            <View
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginVertical="6dp"
                android:background="@color/shimmer_placeholder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginVertical="6dp"
                android:background="@color/shimmer_placeholder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginVertical="6dp"
                android:background="@color/shimmer_placeholder" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <include
        android:id="@+id/empty_label"
        layout="@layout/view_state_message" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/albums_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="90dp" />

</LinearLayout>
