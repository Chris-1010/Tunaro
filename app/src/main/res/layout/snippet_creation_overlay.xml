<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent_black"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Snippet Creation Controls -->
    <androidx.cardview.widget.CardView
        android:id="@+id/snippet_controls_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        app:cardBackgroundColor="@color/surface_raised"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/snippet_title_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:hint="Snippet Title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/snippet_title_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAlignment="center"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Preview Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="start|fill|fill_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/preview_start_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Preview Start"
                    android:textSize="@dimen/text_caption" />

                <Button
                    android:id="@+id/preview_end_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:includeFontPadding="true"
                    android:paddingHorizontal="25dp"
                    android:text="Preview End"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <!-- Set Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/set_start_button"
                    style="@style/Widget.AppCompat.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="Set Start" />

                <Button
                    android:id="@+id/set_end_button"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="Set End" />
            </LinearLayout>

            <!-- Time Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Start Time Editor -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Start Time"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/start_time_layout"
                        style="@style/Widget.Tunaro.NoteInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        app:errorEnabled="true"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/start_time_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789:."
                            android:gravity="center"
                            android:hint="0:00.000"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="time"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_tertiary"
                            android:textSize="@dimen/text_body_small" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- End Time Editor -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="End Time"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/end_time_layout"
                        style="@style/Widget.Tunaro.NoteInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        app:errorEnabled="true"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/end_time_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789:."
                            android:gravity="center"
                            android:hint="0:00.000"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="time"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_tertiary"
                            android:textSize="@dimen/text_body_small" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Include in Rankings Checkbox -->
                <CheckBox
                    android:id="@+id/include_in_rankings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Include in rankings"
                    android:textColor="@color/text_primary" />

                <!-- Delete Snippet Button -->
                <ImageButton
                    android:id="@+id/delete_snippet_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete snippet"
                    android:src="@android:drawable/ic_menu_delete"
                    android:visibility="gone"
                    app:tint="@android:color/holo_red_light" />

            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|fill|fill_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/cancel_snippet_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="Cancel" />

                <Button
                    android:id="@+id/save_snippet_button"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Save Snippet" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginBottom="@dimen/space_sm"
        android:gravity="center|fill_horizontal"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/snippet_playback_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/snippet_warning_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/snippet_playback_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/snippet_controls_card"
            tools:text="Play this song to create a snippet"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/snippet_warning_play_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="@string/play"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@drawable/play_circle_outline"
            android:visibility="gone"
            app:tint="@color/active"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Enhanced Playback Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/snippet_playback_bar"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="45dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:paddingTop="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/snippet_playback_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/playback_bar_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/snippet_album_cover"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="Album Cover"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@tools:sample/avatars" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/snippet_play_pause"
            app:layout_constraintStart_toEndOf="@+id/snippet_album_cover"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/snippet_song_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Song Name" />

            <TextView
                android:id="@+id/snippet_artist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_small"
                tools:text="Artist Name" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/snippet_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/space_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play/Pause"
            android:src="@drawable/play_circle_filled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white" />

        <!-- Custom Snippet SeekBar with overlays -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginStart="-16dp"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="-16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Main SeekBar -->
            <SeekBar
                android:id="@+id/snippet_seekbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxHeight="2dp"
                android:minHeight="2dp"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="7dp"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="7dp"
                android:progressDrawable="@drawable/thin_seekbar_progress"
                android:splitTrack="false"
                android:thumb="@drawable/seekbar_thumb_small"
                android:thumbOffset="0dp" />

            <!-- Snippet Range Overlay -->
            <View
                android:id="@+id/snippet_range_overlay"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_md"
                android:background="#FF4CAF50"
                android:visibility="gone" />

            <!-- Start Marker -->
            <View
                android:id="@+id/snippet_start_marker"
                android:layout_width="4dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/space_md"
                android:background="#FFFF5722"
                android:visibility="gone" />

            <!-- End Marker -->
            <View
                android:id="@+id/snippet_end_marker"
                android:layout_width="4dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/space_md"
                android:background="#FFFF5722"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>