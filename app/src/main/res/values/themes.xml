<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The app is always drawn on a dark canvas, so the theme is dark in both
         system light and dark mode. Colours come from the tokens in colors.xml. -->
    <style name="Theme.Tunaro" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary / secondary: the tan accent drives buttons, switches, progress and cursors. -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <!-- Surfaces: sheets, dialogs, menus. -->
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <!-- Readable red: error text and field outlines sit on dark surfaces. -->
        <item name="colorError">@color/danger_text</item>
        <!-- Dialogs and bottom sheets share one surface treatment (see styles.xml). -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Tunaro.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Tunaro.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Tunaro.BottomSheet</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <!-- Status bar (translucent: content draws behind it). -->
        <item name="android:statusBarColor">@color/brand_blue</item>
        <!-- Navigation Bar -->
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:navigationBarColor">@color/transparent_black</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <!-- Launch theme: the system draws this as the starting window before
         MainActivity inflates, eliminating the blank/white frame on cold start. -->
    <style name="Theme.Tunaro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Tunaro</item>
    </style>
</resources>
